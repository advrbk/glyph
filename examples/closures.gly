# Closures capture variables, not values.
fn counter(start) {
  let count = start
  fn() {
    count += 1
    count
  }
}

let a = counter(0)
let b = counter(100)
a()
a()
print("a:", a(), "b:", b())

# Each loop iteration gets a fresh variable, so each closure remembers its own i.
let callbacks = []
for i in 0..4 {
  push(callbacks, fn() => i * i)
}
print(map(callbacks, fn(f) => f()))

# A variable declared outside the loop is shared by every closure.
let shared = 0
let adders = []
for i in 1..=3 {
  push(adders, fn() { shared += i; shared })
}
for f in adders { f() }
print("shared:", shared)

# Functions are values: compose them.
fn compose(f, g) => fn(x) => f(g(x))
const inc = fn(x) => x + 1
const double = fn(x) => x * 2
print(compose(inc, double)(5), compose(double, inc)(5))
