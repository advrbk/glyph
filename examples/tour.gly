# The snippets from the language tour in README.md, run as one program.
fn counter(start) {
  let count = start
  fn() {
    count += 1
    count
  }
}

let next = counter(10)
next()
print("next is {next()}")

let scores = [72, 95, 58, 88]
let passed = scores |> filter(fn(s) => s >= 65) |> map(fn(s) => s + 5)
print(passed, reduce(passed, fn(a, b) => a + b, 0))

let n = 42
let s = "text"
let ok = true
let nothing = nil
const PI = 3.14159
n += 1
print(n, s, ok, nothing, PI)

let name = "Ada"
print("hello, {name}! 2 + 2 = {2 + 2}")
print("braces: \{ \}, quote: \", newline: \n")
print(len(name), name[0], slice(name, 1, 3), split("a,b", ","), join([1, 2], "-"))

let size = if n > 100 { "big" } else if n > 10 { "medium" } else { "small" }
let area = do {
  let w = 3
  let h = 4
  w * h
}
print(size, area)

while n > 0 {
  n -= 10
  if n == 12 { continue }
  if n < 5 { break }
}
print(n)

for i in 0..5 { print(i) }
for i in 1..=3 { print(i) }
for x in [10, 20] { print(x) }
for ch in "hey" { print(ch) }
for key in {a: 1, b: 2} { print(key) }

fn add(a, b) => a + b
fn fact(n) {
  if n <= 1 { return 1 }
  n * fact(n - 1)
}
const square = fn(x) => x * x
fn makeAdder(k) => fn(x) => x + k
print(add(1, 2), fact(5), square(7), makeAdder(10)(5))

let fs = []
for i in 0..3 { push(fs, fn() => i) }
print(map(fs, fn(f) => f()))

let xs = [3, 1, 2]
xs[0] = 9
push(xs, 4)
print(xs, len(xs))
print(pop(xs), xs)

let book = {title: "Dune", "page count": 412, [name]: true}
book.year = 1965
print(book.title, book["page count"], book["missing"])
print(keys(book), has(book, "year"))

let total = 1..=10 |> filter(fn(x) => x % 2 == 0) |> map(fn(x) => x * x) |> reduce(fn(a, b) => a + b, 0)
print(total)
